# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Use the "Transaction" mode pooler URL for production:
#   postgresql+asyncpg://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=


# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found at: Supabase Dashboard > Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Found at: Supabase Dashboard > Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3000
